MATCH (?cty:City)-[?e0:IS_PART_OF]->(?c:Country), (?p:Person)-[?e1:IS_LOCATED_IN]->(?cty:City), (?f:Forum)-[?e2:HAS_MEMBER]->(?p:Person), (?f:Forum)-[?e3:CONTAINER_OF]->(?m:Post), (?m2:Comment)-[?e4:REPLY_OF]->(?m:Post), (?m2:Comment)-[?e5:HAS_TAG]->(?t:Tag), (?t:Tag)-[?e6:HAS_TYPE]->(?tc:TagClass) RETURN ?cty, ?e0, ?c, ?p, ?e1, ?f, ?e2, ?e3, ?m, ?m2, ?e4, ?e5, ?t, ?e6, ?tc
MATCH (?p1:Person)-[?e1:KNOWS]->(?p2:Person), (?m:Comment)-[?e2:HAS_CREATOR]->(?p1:Person), (?m:Comment)-[?e3:REPLY_OF]->(?m2:Post), (?m2:Post)-[?e4:HAS_CREATOR]->(?p2:Person) RETURN ?p1, ?e1, ?p2, ?m, ?e2, ?e3, ?m2, ?e4
MATCH (?p1:Person)-[?e1:IS_LOCATED_IN]->(?c1:City), (?c1:City)-[?e2:IS_PART_OF]->(?country:Country), (?p2:Person)-[?e3:IS_LOCATED_IN]->(?c2:City), (?c2:City)-[?e4:IS_PART_OF]->(?country:Country), (?p3:Person)-[?e5:IS_LOCATED_IN]->(?c3:City), (?c3:City)-[?e6:IS_PART_OF]->(?country:Country), (?p1:Person)-[?e7:KNOWS]->(?p2:Person), (?p2:Person)-[?e8:KNOWS]->(?p3:Person), (?p3:Person)-[?e9:KNOWS]->(?p1:Person) WHERE (?e1 != e3) AND (?e1 != e5) AND (?e3 != e5) AND (?e7 != e8) AND (?e7 != e9) AND (?e8 != e9) RETURN ?p1, ?e1, ?c1, ?e2, ?country, ?p2, ?e3, ?c2, ?e4, ?p3, ?e5, ?c3, ?e6, ?e7, ?e8, ?e9
MATCH (?m:Message)-[?e1:HAS_TAG]->(?t:Tag), (?m:Message)-[?e2:HAS_CREATOR]->(?c:Person), (?l:Person)-[?e3:LIKES]->(?m:Message), (?com:Comment)-[?e4:REPLY_OF]->(?m:Message) RETURN ?m, ?e1, ?t, ?e2, ?c, ?l, ?e3, ?com, ?e4
MATCH (?m:Message)-[?e1:HAS_TAG]->(?t1:Tag), (?c:Comment)-[?e2:REPLY_OF]->(?m:Message), (?c:Comment)-[?e3:HAS_TAG]->(?t2:Tag) WHERE (?t1 != ?t2) RETURN ?m, ?e1, ?t1, ?c, ?e2, ?e3, ?t2
MATCH (?p1:Person)-[?e1:KNOWS]->(?p2:Person), (?p2:Person)-[?e2:KNOWS]->(?p3:Person), (?p3:Person)-[?e3:HAS_INTEREST]->(?t:Tag) WHERE (?p1 != ?p3) RETURN ?p1, ?e1, ?p2, ?e2, ?p3, ?e3, ?t

